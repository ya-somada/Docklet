<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Docklet.Pages.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Docklet.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView
        x:Name="NavView"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="True"
        Loaded="NavView_Loaded"
        PaneDisplayMode="Left"
        SelectionChanged="NavView_SelectionChanged"
        Unloaded="NavView_Unloaded">
        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="HomeNavItem"
                x:Uid="Nav_Home"
                Icon="Home"
                Tag="home" />
            <NavigationViewItem
                x:Name="ContainersNavItem"
                x:Uid="Nav_Containers"
                Icon="AllApps"
                Tag="containers" />
            <NavigationViewItem
                x:Name="ImagesNavItem"
                x:Uid="Nav_Images"
                Tag="images">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Library" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="VolumesNavItem"
                x:Uid="Nav_Volumes"
                Tag="volumes">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEDA2;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="NetworksNavItem"
                x:Uid="Nav_Networks"
                Tag="networks">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE968;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
    </NavigationView>
</Page>
