<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Docklet.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Uid="Home_Title"
                VerticalAlignment="Center"
                Style="{ThemeResource TitleTextBlockStyle}" />
            <Button
                x:Name="RefreshButton"
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock
                        x:Name="RefreshButtonText"
                        VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            IsClosable="True"
            IsOpen="False" />

        <Grid Grid.Row="2">
            <ProgressRing
                x:Name="OverviewProgress"
                Width="32"
                Height="32"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsActive="True" />

            <ScrollViewer x:Name="OverviewView" Visibility="Collapsed">
                <StackPanel Spacing="16">
                    <Border
                        Padding="20,16"
                        HorizontalAlignment="Stretch"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource OverlayCornerRadius}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon
                                FontSize="16"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE7B8;" />
                            <TextBlock
                                x:Name="EngineVersionText"
                                VerticalAlignment="Center"
                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="&#183;" />
                            <TextBlock
                                x:Name="EngineOsText"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{ThemeResource BodyTextBlockStyle}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Border
                            MinWidth="160"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Uid="Home_RunningContainers"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="RunningCountText"
                                    HorizontalAlignment="Right"
                                    Style="{ThemeResource DisplayTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                        <Border
                            MinWidth="160"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Uid="Home_Images"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="ImagesCountText"
                                    HorizontalAlignment="Right"
                                    Style="{ThemeResource DisplayTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                        <Border
                            MinWidth="160"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Uid="Home_Volumes"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="VolumesCountText"
                                    HorizontalAlignment="Right"
                                    Style="{ThemeResource DisplayTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                        <Border
                            MinWidth="160"
                            Padding="20"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource OverlayCornerRadius}">
                            <StackPanel Spacing="8">
                                <TextBlock
                                    x:Uid="Home_Networks"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="NetworksCountText"
                                    HorizontalAlignment="Right"
                                    Style="{ThemeResource DisplayTextBlockStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
